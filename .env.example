# ── Stellar / Soroban ──────────────────────────────────────────────────────────
# Contract ID of the deployed RepoFlow Soroban smart contract.
NEXT_PUBLIC_CONTRACT_ID=CBAK7SEF7V6CHIZL4GJLJYEL44N3SIUMJXFFE7IGPLAXAR5MTLWFANRW

# Soroban RPC endpoint for transaction simulation and submission.
NEXT_PUBLIC_RPC_URL=https://rpc-futurenet.stellar.org

# Network passphrase matching the target Stellar network.
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Future Network ; October 2022

# ── Backend API ────────────────────────────────────────────────────────────────
# URL of the repoflow-indexer REST API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── GitHub OAuth ───────────────────────────────────────────────────────────────
# GitHub OAuth App client ID for user authentication.
GITHUB_CLIENT_ID=your_github_oauth_client_id

# GitHub OAuth App client secret for token exchange.
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# ── NextAuth.js ────────────────────────────────────────────────────────────────
# Secret key for encrypting NextAuth session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_32_char_secret

# Canonical URL of the deployed application.
NEXTAUTH_URL=http://localhost:3000
